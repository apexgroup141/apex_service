{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apexservice",
  "compatibility_date": "2026-07-12",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/reviews", "/*.html"]
  },
  "triggers": {
    "crons": ["17 */3 * * *"]
  },
  "vars": {
    "GOOGLE_BUSINESS_ACCOUNT_ID": "116696538401694307878",
    "GOOGLE_BUSINESS_LOCATION_ID": "2978863217463563301"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zayavki",
      "database_id": "bc4f1c2c-d50c-46d5-a23e-09b13b08c113"
    }
  ]
}
